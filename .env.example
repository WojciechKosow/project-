# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored (see .gitignore), so your real password and
# secret never get committed. Next.js loads `.env.local` automatically.
# -----------------------------------------------------------------------------

# How the app connects to your local Postgres database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
#   USER      Postgres role/username (default install often uses "postgres")
#   PASSWORD  that role's password  <-- THIS is where your DB password goes
#   HOST      localhost (your PC)
#   PORT      5432 (Postgres default)
#   DATABASE  the database name you created (see SETUP.md), e.g. "acme"
#
# Example:
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/acme

# Secret used to SIGN the JWT session tokens. Must be long and random.
# Generate one with:   openssl rand -base64 32
# Keep it secret; anyone who has it can forge login tokens.
JWT_SECRET=replace_me_with_a_long_random_string
